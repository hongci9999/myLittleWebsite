{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install --no-save @rollup/rollup-linux-x64-gnu@$(node -p \"require('rollup/package.json').version\") && npm run build -w client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/sources", "schedule": "0 18 * * *" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{docs/learnings/**,docs/decisions/**,docs/error-fixes/**,docs/journal/**,client/public/about.md,client/src/shared/config/projects.json}"
    }
  }
}
